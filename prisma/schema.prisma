generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String
  price       Float?
  category    String    // TRACTOR, ATV, UTV, EQUIPMENT, OILS
  brand       String
  year        Int?
  horsepower  String?
  engine      String?
  weight      String?
  viscosity   String?
  volumeValue Float?
  volumeUnit  String?
  images      String    // JSON array stored as string
  address     String?
  lat         Float?
  lon         Float?
  featured    Boolean   @default(false)
  hidden      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  inquiries   Inquiry[]
  colors      Color[]   @relation("ProductColors")
  colorImages ProductColorImage[]

  @@index([category, hidden])
  @@index([brand])
  @@index([featured])
}

model Color {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  hex       String
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  products  Product[] @relation("ProductColors")
  colorImages ProductColorImage[]
}

model ProductColorImage {
  id        Int      @id @default(autoincrement())
  productId Int
  colorId   Int
  imageUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     Color    @relation(fields: [colorId], references: [id], onDelete: Cascade)

  @@unique([productId, colorId])
  @@index([colorId])
}

model Inquiry {
  id                Int      @id @default(autoincrement())
  productId         Int
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name              String
  email             String
  phone             String?
  message           String
  selectedColorName String?
  selectedColorHex  String?
  createdAt         DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model SiteContent {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
}

model ErrorLog {
  id         Int      @id @default(autoincrement())
  level      String   @default("error")
  message    String
  stack      String?
  route      String?
  method     String?
  statusCode Int?
  context    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([level])
}
