generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String
  price       Float?
  category    String    // TRACTOR, ATV, UTV, EQUIPMENT, OILS
  brand       String
  year        Int?
  horsepower  String?
  engine      String?
  weight      String?
  viscosity   String?
  volumeValue Float?
  volumeUnit  String?
  images      String    // JSON array stored as string
  address     String?
  lat         Float?
  lon         Float?
  featured    Boolean   @default(false)
  hidden      Boolean   @default(false)
  sortOrder   Int       @default(0)
  // Promotion feature: a product belongs to at most one promotion (single- or
  // multi-product). Deleting the promotion detaches the product (SetNull).
  promotionId Int?
  promotion   Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  inquiries   Inquiry[]
  colors      Color[]   @relation("ProductColors")
  colorImages ProductColorImage[]

  @@index([category, hidden])
  @@index([brand])
  @@index([featured])
  @@index([sortOrder])
  // #12: speeds up the OILS import preload (existing products by brand+category).
  @@index([brand, category])
  // #22: covers the catalog filter (category, hidden) + sort (sortOrder desc, createdAt desc).
  @@index([category, hidden, sortOrder, createdAt])
  @@index([promotionId])
}

/// A time-boxed promotion applied to one or many products.
/// - type "PRICE":   `promoPriceGross` is the admin-entered promo price INCLUDING
///                   VAT (EUR); the site shows it net of VAT like every other price.
/// - type "PERCENT": `percent` is the discount (0–100) applied to the product's
///                   base (ex-VAT) price. Colour surcharges are added on top of the
///                   discounted base price.
/// - type "OTHER":   no price change (e.g. "на изплащане"): only the ribbon,
///                   the comment and the validity window apply.
model Promotion {
  id              Int       @id @default(autoincrement())
  title           String
  type            String    // PRICE | PERCENT | OTHER
  promoPriceGross Float?
  percent         Float?
  ribbonText      String    @default("ПРОМОЦИЯ")
  comment         String?
  startsAt        DateTime?
  endsAt          DateTime?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  products        Product[]

  @@index([active, startsAt, endsAt])
}

model Color {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  hex       String
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  products  Product[] @relation("ProductColors")
  colorImages ProductColorImage[]
}

model ProductColorImage {
  id        Int      @id @default(autoincrement())
  productId Int
  colorId   Int
  imageUrl  String
  price     Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     Color    @relation(fields: [colorId], references: [id], onDelete: Cascade)

  @@unique([productId, colorId])
  @@index([colorId])
}

model Inquiry {
  id                Int      @id @default(autoincrement())
  productId         Int
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name              String
  email             String
  phone             String?
  message           String
  selectedColorName String?
  selectedColorHex  String?
  createdAt         DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model SiteContent {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

model Admin {
  id             Int      @id @default(autoincrement())
  username       String   @unique
  password       String
  name           String
  // #5: bumped on password change so previously-issued session tokens (which
  // embed the version they were minted with) are rejected by getSession().
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
}

model ErrorLog {
  id         Int      @id @default(autoincrement())
  level      String   @default("error")
  message    String
  stack      String?
  route      String?
  method     String?
  statusCode Int?
  context    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([level])
}
